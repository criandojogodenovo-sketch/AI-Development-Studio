# ============================================================
# AI DEVELOPMENT STUDIO — .env.example
# Copie para .env e preencha. NUNCA comite o .env real.
# Secrets pertencem EXCLUSIVAMENTE ao servidor.
# NUNCA use prefixo NEXT_PUBLIC_ para secrets.
# Em produção (Vercel): configure tudo em Environment Variables.
#
# LEGENDA (auditoria de 2026-09-05 — código-fonte verificado):
#   [OBRIGATÓRIA]  sistema não sobe sem ela (validação na inicialização)
#   [OPCIONAL]     tem default seguro; omitir é válido
#   [RESERVADA]    aceita no .env mas NENHUM código consome hoje
# Validação: src/lib/studio/security/env-validator.ts roda no boot
# do servidor (src/instrumentation.ts) com erros claros.
# ============================================================

# ---------- BANCO DE DADOS ----------
# [OBRIGATÓRIA] Connection string do Neon PostgreSQL (server-side APENAS).
# ATENÇÃO: NÃO inclua channel_binding=require — o engine do Prisma não
# suporta esse parâmetro libpq. sslmode=require já garante TLS.
# Ex.: postgresql://USER:PASSWORD@EP-HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# ---------- B.AI (gateway dos modelos — server-side ONLY) ----------
# [OPCIONAL] Duas chaves para disponibilidade/failover ELEGÍVEL
# (rede/5xx/timeout). Rate limit (429) NUNCA dispara failover.
# Sem chaves: sandbox usa o SDK local (z-ai-web-dev-sdk).
# Em produção, configure ao menos uma.
BAI_API_KEY_1=
BAI_API_KEY_2=
# [OPCIONAL] Endpoint OpenAI-compatible da B.AI
BAI_BASE_URL=https://api.b.ai/v1

# ---------- NVIDIA (provider adicional — NIM, OpenAI-compatible) ----------
# [OPCIONAL] Participa do chain de providers conforme POSKLI_VERSION.
# Sem chave → provider fica FORA do chain (comportamento inalterado).
# Catálogo validado ao vivo (2026-09-06, GET /v1/models).
NVIDIA_API_KEY=
# [OPCIONAL] Endpoint (default abaixo)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# [OPCIONAL] Modelos por papel (defaults = ids reais do endpoint)
NVIDIA_MODEL_MASTER=nvidia/nemotron-3-super-120b-a12b
NVIDIA_MODEL_CODING=deepseek-ai/deepseek-v4-flash-0731
NVIDIA_MODEL_REVIEW=openai/gpt-oss-20b

# ---------- CHAIN DE PROVIDERS (roteamento por versão do Poskli) ----------
# [OPCIONAL] 0.1 | 0.2 | 0.3.1 | 1.0-flash | superagent
#   0.1        : B.AI (master Qwen · coding Hy3 · review Qwen)
#   0.2        : B.AI → NVIDIA                    (default)
#   0.3.1      : B.AI → NVIDIA (review GPT-OSS-20B)
#   1.0-flash  : NVIDIA prioritário → B.AI (reserva)
#   superagent : B.AI (dupla coding Hy3+Qwen) → NVIDIA
# O SELETOR DE MODELOS da UI envia poskliVersion por requisição — esta
# env é o DEFAULT quando o parâmetro não é enviado.
# POLÍTICA ANTI-RATE-LIMIT (Tarefa C): 429 → backoff 5s/10s/20s (máx
# 3 tentativas) → QUOTA_EXHAUSTED para o run honestamente (nunca
# correções para erro de quota). Fallback inteligente por modelo:
# Qwen→GLM imediato (0.3.1, mesma conta); NVIDIA→B.AI após 1 retry
# (1.0-flash). Rotação de chaves B.AI: só em rede/5xx, NUNCA em 429.
POSKLI_VERSION=0.2

# ---------- MODELOS (nomes configuráveis) ----------
# [OPCIONAL] defaults abaixo. (compat legado: MODEL_MASTER/MODEL_CODING/MODEL_REVIEW)
GLM_MODEL=glm-5.3-flash
QWEN_MODEL=qwen3.8-flash
HY3_MODEL=hy3
DEEPSEEK_MODEL=deepseek-v4-flash
# GPT-5.6 Luna — fallback de REVIEW (B.AI) quando o NVIDIA falha
# por quota/região (0.3.1 / 1.0-flash / superagent)
LUNA_MODEL=gpt-5.6-luna

# [OPCIONAL] DeepSeek DESATIVADO por padrão — o sistema funciona
# COMPLETAMENTE sem DeepSeek. Gate triplo no ModelRouter:
# chamada direta, disponibilidade e fallback — todos bloqueiam.
ENABLE_DEEPSEEK=false
# Limite diário quando habilitado
DEEPSEEK_MAX_DAILY_REQUESTS=10
# Timeout por requisição LLM (ms)
MODEL_REQUEST_TIMEOUT_MS=180000

# ---------- FAILOVER DE CHAVES B.AI ----------
BAI_FAILURES_BEFORE_COOLDOWN=3
BAI_KEY_COOLDOWN_MS=60000

# ---------- LIMITES DO LOOP (nunca loop infinito) ----------
AGENT_MAX_STEPS=30
AGENT_MAX_RETRIES=3
# Ciclos de correção: teto p/ tarefas difíceis (2); simples usam 1
MAX_REVIEW_CYCLES=2
MAX_REVIEW_CYCLES_SIMPLE=1
MAX_TOOL_CALLS=60
MAX_TOTAL_EXECUTION_TIME=900000
REPEATED_FAILURE_THRESHOLD=3

# ---------- EXECUÇÃO / SANDBOX ----------
# local | docker | remote (docker/remote ainda não implementados —
# o validador avisa; apenas local executa de verdade)
EXECUTION_PROVIDER=local
# Caminho ABSOLUTO (obrigatório se definir)
WORKSPACES_ROOT=/home/z/my-project/workspaces
MAX_COMMAND_TIMEOUT=120000
MAX_PROCESS_COUNT=50
MAX_OUTPUT_BYTES=200000

# ---------- ARQUIVOS ----------
MAX_FILE_SIZE=2000000
MAX_PROJECT_SIZE=100000000
MAX_FILE_READ_BYTES=400000

# ---------- GITHUB (server-side APENAS) ----------
# [RESERVADA] OAuth app — NÃO consumida pelo código atual (futuro).
# Manter segredo mesmo assim. NUNCA NEXT_PUBLIC_GITHUB_CLIENT_SECRET.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# [OPCIONAL] Token de acesso pessoal com escopo mínimo (repo) —
# SOMENTE para inicialização; credencial temporária, rotacionável.
# O projeto NÃO deve depender de token permanente. Nunca exposto
# ao frontend (apenas last-4 no status).
GITHUB_TOKEN=
GITHUB_MAX_REPO_MB=200

# ---------- SEGURANÇA ----------
# [RESERVADA] Autenticação atual usa tokens opacos com hash no DB
# (crypto.randomBytes) — AUTH_SECRET não é consumida pelo fluxo de
# sessão. Defina um segredo forte (>= 32 chars) para usos futuros
# de assinatura. Em produção, o validador ERRA se estiver no default.
AUTH_SECRET=troque-por-um-segredo-forte-aleatorio
SESSION_TTL_HOURS=168
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RUN_RATE_LIMIT_PER_MIN=6

# ---------- EVENTOS / TEMPO REAL (opcional no deploy) ----------
EVENTS_PORT=3003
EVENTS_INGEST_PORT=3004

# ---------- CONTEXTO (economia de tokens — Tarefa C) ----------
CONTEXT_MAX_FILES=12
CONTEXT_MAX_FILE_CHARS=6000
CONTEXT_MAX_HISTORY_STEPS=10
# Outputs de ferramentas → 2.000 chars com marcador
# "[Output truncado - 2k chars]" antes de ir ao LLM
CONTEXT_MAX_TOOL_OUTPUT_CHARS=2000
CONTEXT_MAX_TEST_OUTPUT_CHARS=2000

# ---------- APP ----------
# [RESERVADA] Nenhuma referência no código atual. NÃO coloque
# secrets aqui — qualquer NEXT_PUBLIC_* vai para o bundle do cliente.
NEXT_PUBLIC_APP_URL=http://localhost:3000
