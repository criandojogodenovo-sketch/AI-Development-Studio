# ============================================================
# AI DEVELOPMENT STUDIO — .env.example
# Copie para .env e preencha. NUNCA comite o .env real.
# Secrets pertencem EXCLUSIVAMENTE ao servidor.
# NUNCA use prefixo NEXT_PUBLIC_ para secrets.
# Em produção (Vercel): configure tudo em Environment Variables.
# ============================================================

# ---------- BANCO DE DADOS (Neon PostgreSQL) ----------
# Connection string do Neon (server-side APENAS).
# Ex.: postgresql://USER:PASSWORD@EP-HOST.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# ---------- B.AI (gateway dos modelos — server-side ONLY) ----------
# Duas chaves para disponibilidade/failover ELEGÍVEL (rede/5xx/timeout).
# Rate limit (429) NUNCA dispara failover — regra do sistema.
BAI_API_KEY_1=
BAI_API_KEY_2=
# Endpoint OpenAI-compatible da B.AI (ajuste conforme documentação)
BAI_BASE_URL=https://api.b.ai/v1

# ---------- MODELOS (nomes configuráveis) ----------
GLM_MODEL=glm-5.3-flash
QWEN_MODEL=qwen3.8-flash
HY3_MODEL=hy3
DEEPSEEK_MODEL=deepseek-v4-flash

# DeepSeek DESATIVADO por padrão — o sistema funciona
# COMPLETAMENTE sem DeepSeek.
ENABLE_DEEPSEEK=false
# Limite diário quando habilitado
DEEPSEEK_MAX_DAILY_REQUESTS=10
# Timeout por requisição LLM (ms)
MODEL_REQUEST_TIMEOUT_MS=180000

# ---------- FAILOVER DE CHAVES B.AI ----------
BAI_FAILURES_BEFORE_COOLDOWN=3
BAI_KEY_COOLDOWN_MS=60000

# ---------- LIMITES DO LOOP (nunca loop infinito) ----------
AGENT_MAX_STEPS=30
AGENT_MAX_RETRIES=3
MAX_REVIEW_CYCLES=5
MAX_TOOL_CALLS=60
MAX_TOTAL_EXECUTION_TIME=900000
REPEATED_FAILURE_THRESHOLD=3

# ---------- EXECUÇÃO / SANDBOX ----------
# local | docker | remote (docker/remote requer implementação do provider)
EXECUTION_PROVIDER=local
WORKSPACES_ROOT=/home/z/my-project/workspaces
MAX_COMMAND_TIMEOUT=120000
MAX_PROCESS_COUNT=50
MAX_OUTPUT_BYTES=200000

# ---------- ARQUIVOS ----------
MAX_FILE_SIZE=2000000
MAX_PROJECT_SIZE=100000000
MAX_FILE_READ_BYTES=400000

# ---------- GITHUB (server-side APENAS) ----------
# OAuth app (futuro). NUNCA NEXT_PUBLIC_GITHUB_TOKEN.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Token de acesso pessoal com escopo mínimo (repo) — SOMENTE para
# inicialização; credencial temporária, rotacionável. O projeto
# NÃO deve depender de token permanente.
GITHUB_TOKEN=
GITHUB_MAX_REPO_MB=200

# ---------- SEGURANÇA ----------
AUTH_SECRET=troque-por-um-segredo-forte-aleatorio
SESSION_TTL_HOURS=168
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RUN_RATE_LIMIT_PER_MIN=6

# ---------- EVENTOS / TEMPO REAL (opcional no deploy) ----------
EVENTS_PORT=3003
EVENTS_INGEST_PORT=3004

# ---------- CONTEXTO (economia de tokens/créditos) ----------
CONTEXT_MAX_FILES=12
CONTEXT_MAX_FILE_CHARS=6000
CONTEXT_MAX_HISTORY_STEPS=10
CONTEXT_MAX_TEST_OUTPUT_CHARS=3000

# ---------- APP ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
